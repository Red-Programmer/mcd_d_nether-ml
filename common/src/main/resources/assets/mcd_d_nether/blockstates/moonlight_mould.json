        "model": "mcd_d_nether:block/mould/moonlight_stem"
      },
      "when": {
        "cap": "false",
        "corner": "false",
        "edge": "false",
        "facing": "up",
        "half": "lower",
        "upper": "false"
      }
    }
  ]
