{
  "multipart": [
    {
      "apply": {
        "model": "mcd_d_nether:block/mould/moonlight_cap"
      },
      "when": {
        "cap": "true",
        "corner": "false",
        "edge": "false",
        "facing": "up",
        "half": "upper",
        "upper": "false"
      }
    },
    {
